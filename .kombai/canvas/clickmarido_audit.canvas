      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100;200;300;400;500;600&family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-glacier: #F8FAFC;\n    --text-frost: #1E293B;\n    --accent-ice: #38BDF8;\n    --snow-pale: #E2E8F0;\n    --glass-frosted: rgba(255, 255, 255, 0.85);\n  }\n\n  body {\n    background-color: var(--bg-glacier);\n    color: var(--text-frost);\n    font-family: 'Geist', sans-serif;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-inter { font-family: 'Inter', sans-serif; }\n\n  .glass-card {\n    background: var(--glass-frosted);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border-radius: 24px;\n    box-shadow: 0 4px 40px rgba(0, 0, 0, 0.02);\n    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .glass-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 10px 50px rgba(56, 189, 248, 0.05);\n  }\n\n  .sidebar-link {\n    transition: all 0.3s ease;\n    border-radius: 12px;\n  }\n\n  .sidebar-link:hover {\n    background: rgba(56, 189, 248, 0.05);\n    color: var(--accent-ice);\n  }\n\n  .sidebar-link.active {\n    background: white;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);\n    color: var(--accent-ice);\n  }\n\n  .chart-grid line {\n    stroke: var(--snow-pale);\n    stroke-opacity: 0.3;\n  }\n\n  .stat-value {\n    font-weight: 200;\n    letter-spacing: -0.05em;\n  }\n\n  .micro-label {\n    text-transform: uppercase;\n    letter-spacing: 0.25em;\n    font-size: 0.65rem;\n    font-weight: 600;\n    opacity: 0.5;\n  }\n</style>\n\n<div class=\"flex min-h-screen\" data-kid=\"1\">\n  \n  <aside class=\"w-72 p-8 flex flex-col border-r border-slate-100/50 bg-white/30 backdrop-blur-xl\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3 mb-12\" data-kid=\"3\">\n      <div class=\"w-10 h-10 rounded-2xl bg-sky-500/10 flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-snowflake text-sky-500 text-xl\" data-kid=\"5\"></i>\n      </div>\n      <div data-kid=\"6\">\n        <h2 class=\"text-lg font-bold tracking-tight\" data-kid=\"7\">Click Marido</h2>\n        <p class=\"micro-label\" data-kid=\"8\">Arctic CRM</p>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 space-y-2\" data-kid=\"9\">\n      <a href=\"#\" class=\"sidebar-link active flex items-center gap-4 px-4 py-3 text-sm font-medium\" data-kid=\"10\">\n        <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"11\"></i> Overview\n      </a>\n      <a href=\"#\" class=\"sidebar-link flex items-center gap-4 px-4 py-3 text-sm font-medium opacity-60\" data-kid=\"12\">\n        <i class=\"ti ti-users text-lg\" data-kid=\"13\"></i> Clientes\n      </a>\n      <a href=\"#\" class=\"sidebar-link flex items-center gap-4 px-4 py-3 text-sm font-medium opacity-60\" data-kid=\"14\">\n        <i class=\"ti ti-file-text text-lg\" data-kid=\"15\"></i> Orçamentos\n      </a>\n      <a href=\"#\" class=\"sidebar-link flex items-center gap-4 px-4 py-3 text-sm font-medium opacity-60\" data-kid=\"16\">\n        <i class=\"ti ti-chart-bar text-lg\" data-kid=\"17\"></i> Analytics\n      </a>\n    </nav>\n\n    <div class=\"pt-8 border-t border-slate-100\" data-kid=\"18\">\n      <div class=\"flex items-center gap-4\" data-kid=\"19\">\n        <div class=\"w-10 h-10 rounded-full bg-slate-200 overflow-hidden\" data-kid=\"20\">\n          <img src=\"https://i.pravatar.cc/80?u=arctic\" alt=\"Avatar\" class=\"w-full h-full object-cover\" data-kid=\"21\">\n        </div>\n        <div data-kid=\"22\">\n          <p class=\"text-sm font-semibold\" data-kid=\"23\">Admin User</p>\n          <p class=\"text-[10px] opacity-40 font-bold uppercase tracking-widest\" data-kid=\"24\">Executive</p>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 p-12 overflow-y-auto\" data-kid=\"25\">\n    \n    <header class=\"flex justify-between items-end mb-16\" data-kid=\"26\">\n      <div class=\"space-y-1\" data-kid=\"27\">\n        <p class=\"micro-label\" data-kid=\"28\">Dashboard Overview</p>\n        <h1 class=\"text-4xl font-light tracking-tight\" data-kid=\"29\">Welcome back, <span class=\"font-semibold\" data-kid=\"30\">Arctic.</span></h1>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"31\">\n        <button class=\"px-6 py-3 rounded-2xl bg-white shadow-sm border border-slate-100 text-sm font-semibold hover:shadow-md transition-all\" data-kid=\"32\">\n          <i class=\"ti ti-settings mr-2\" data-kid=\"33\"></i> Settings\n        </button>\n        <button class=\"px-6 py-3 rounded-2xl bg-sky-500 text-white shadow-lg shadow-sky-500/20 text-sm font-bold hover:scale-105 transition-all\" data-kid=\"34\">\n          <i class=\"ti ti-plus mr-2\" data-kid=\"35\"></i> New Project\n        </button>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-4 gap-8 mb-12\" data-kid=\"36\">\n      <div class=\"glass-card p-8\" data-kid=\"37\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"38\">\n          <p class=\"micro-label text-slate-400\" data-kid=\"39\">Total Revenue</p>\n          <i class=\"ti ti-trending-up text-sky-400\" data-kid=\"40\"></i>\n        </div>\n        <div class=\"flex items-baseline gap-1\" data-kid=\"41\">\n          <span class=\"text-sm font-bold opacity-30\" data-kid=\"42\">R$</span>\n          <h3 class=\"stat-value text-6xl font-inter\" data-kid=\"43\">124k</h3>\n        </div>\n        <p class=\"text-[10px] font-bold text-sky-500 mt-4\" data-kid=\"44\"><i class=\"ti ti-arrow-up-right\" data-kid=\"45\"></i> +12.5% this month</p>\n      </div>\n\n      <div class=\"glass-card p-8\" data-kid=\"46\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"47\">\n          <p class=\"micro-label text-slate-400\" data-kid=\"48\">Active Leads</p>\n          <i class=\"ti ti-user-plus text-sky-400\" data-kid=\"49\"></i>\n        </div>\n        <h3 class=\"stat-value text-6xl font-inter\" data-kid=\"50\">852</h3>\n        <p class=\"text-[10px] font-bold text-slate-400 mt-4 uppercase tracking-widest\" data-kid=\"51\">Growth phase</p>\n      </div>\n\n      <div class=\"glass-card p-8\" data-kid=\"52\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"53\">\n          <p class=\"micro-label text-slate-400\" data-kid=\"54\">Conversion</p>\n          <i class=\"ti ti-chart-pie text-sky-400\" data-kid=\"55\"></i>\n        </div>\n        <div class=\"flex items-baseline gap-1\" data-kid=\"56\">\n          <h3 class=\"stat-value text-6xl font-inter\" data-kid=\"57\">64</h3>\n          <span class=\"text-sm font-bold opacity-30\" data-kid=\"58\">%</span>\n        </div>\n        <p class=\"text-[10px] font-bold text-emerald-500 mt-4\" data-kid=\"59\"><i class=\"ti ti-circle-check\" data-kid=\"60\"></i> Optimization high</p>\n      </div>\n\n      <div class=\"glass-card p-8\" data-kid=\"61\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"62\">\n          <p class=\"micro-label text-slate-400\" data-kid=\"63\">Wait Time</p>\n          <i class=\"ti ti-clock text-sky-400\" data-kid=\"64\"></i>\n        </div>\n        <div class=\"flex items-baseline gap-1\" data-kid=\"65\">\n          <h3 class=\"stat-value text-6xl font-inter\" data-kid=\"66\">12</h3>\n          <span class=\"text-sm font-bold opacity-30\" data-kid=\"67\">min</span>\n        </div>\n        <p class=\"text-[10px] font-bold text-rose-400 mt-4\" data-kid=\"68\"><i class=\"ti ti-arrow-down-right\" data-kid=\"69\"></i> -2m from yesterday</p>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-3 gap-8\" data-kid=\"70\">\n      \n      <div class=\"col-span-2 glass-card p-10 relative overflow-hidden\" data-kid=\"71\">\n        <div class=\"flex justify-between items-center mb-12\" data-kid=\"72\">\n          <h4 class=\"text-lg font-semibold tracking-tight\" data-kid=\"73\">Revenue Stream Velocity</h4>\n          <div class=\"flex gap-2\" data-kid=\"74\">\n            <span class=\"px-3 py-1 rounded-full bg-sky-500/10 text-sky-500 text-[10px] font-black tracking-widest uppercase\" data-kid=\"75\">Real-time</span>\n          </div>\n        </div>\n        \n        \n        <div class=\"h-64 relative\" data-kid=\"76\">\n          <svg class=\"w-full h-full\" viewBox=\"0 0 800 200\" preserveAspectRatio=\"none\" data-kid=\"77\">\n            <defs data-kid=\"78\">\n              <linearGradient id=\"chartGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\" data-kid=\"79\">\n                <stop offset=\"0%\" stop-color=\"#38BDF8\" stop-opacity=\"0.2\" data-kid=\"80\"></stop>\n                <stop offset=\"100%\" stop-color=\"#38BDF8\" stop-opacity=\"0\" data-kid=\"81\"></stop>\n              </linearGradient>\n            </defs>\n            <path d=\"M0,150 Q200,80 400,120 T800,40 L800,200 L0,200 Z\" fill=\"url(#chartGradient)\" data-kid=\"82\"></path>\n            <path d=\"M0,150 Q200,80 400,120 T800,40\" fill=\"none\" stroke=\"#38BDF8\" stroke-width=\"2\" data-kid=\"83\"></path>\n            <circle cx=\"800\" cy=\"40\" r=\"4\" fill=\"#38BDF8\" data-kid=\"84\"></circle>\n          </svg>\n          <div class=\"absolute inset-0 flex justify-between pointer-events-none opacity-20 border-b border-slate-200\" data-kid=\"85\">\n             <div class=\"h-full border-l border-slate-100\" data-kid=\"86\"></div>\n             <div class=\"h-full border-l border-slate-100\" data-kid=\"87\"></div>\n             <div class=\"h-full border-l border-slate-100\" data-kid=\"88\"></div>\n             <div class=\"h-full border-l border-slate-100\" data-kid=\"89\"></div>\n          </div>\n        </div>\n        <div class=\"flex justify-between mt-6 text-[10px] font-bold text-slate-300 uppercase tracking-[0.3em]\" data-kid=\"90\">\n          <span data-kid=\"91\">Jan</span>\n          <span data-kid=\"92\">Mar</span>\n          <span data-kid=\"93\">Jun</span>\n          <span data-kid=\"94\">Sep</span>\n          <span data-kid=\"95\">Dec</span>\n        </div>\n      </div>\n\n      \n      <div class=\"glass-card p-10\" data-kid=\"96\">\n        <h4 class=\"text-lg font-semibold tracking-tight mb-8\" data-kid=\"97\">System Velocity</h4>\n        <div class=\"space-y-8\" data-kid=\"98\">\n          <div class=\"flex items-center gap-4\" data-kid=\"99\">\n            <div class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center\" data-kid=\"100\">\n              <i class=\"ti ti-check text-emerald-500\" data-kid=\"101\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"102\">\n              <p class=\"text-xs font-bold uppercase tracking-widest opacity-40 mb-1\" data-kid=\"103\">Budget Approved</p>\n              <p class=\"text-sm font-semibold\" data-kid=\"104\">Residencial Central X</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-4\" data-kid=\"105\">\n            <div class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center\" data-kid=\"106\">\n              <i class=\"ti ti-clock-pause text-amber-500\" data-kid=\"107\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"108\">\n              <p class=\"text-xs font-bold uppercase tracking-widest opacity-40 mb-1\" data-kid=\"109\">Awaiting Response</p>\n              <p class=\"text-sm font-semibold\" data-kid=\"110\">Manutenção Elétrica G2</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-4\" data-kid=\"111\">\n            <div class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center\" data-kid=\"112\">\n              <i class=\"ti ti-message-dots text-sky-500\" data-kid=\"113\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"114\">\n              <p class=\"text-xs font-bold uppercase tracking-widest opacity-40 mb-1\" data-kid=\"115\">New Message</p>\n              <p class=\"text-sm font-semibold\" data-kid=\"116\">Cliente: João Silva</p>\n            </div>\n          </div>\n        </div>\n\n        <button class=\"w-full mt-12 py-4 rounded-2xl bg-slate-50 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 hover:bg-slate-100 transition-all\" data-kid=\"117\">\n          View All Logs\n        </button>\n      </div>\n    </div>\n  </main>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"118\">",
