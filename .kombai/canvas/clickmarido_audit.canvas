      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-cosmos: #0F0C29;\n    --amethyst: #B14BF4;\n    --indigo: #4B12FE;\n    --starlight: #FFFFFF;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: var(--bg-cosmos);\n    color: var(--starlight);\n    overflow-x: hidden;\n    min-h-screen;\n  }\n\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    opacity: 0.5;\n    animation: move 20s infinite alternate ease-in-out;\n  }\n\n  .orb-1 {\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, var(--amethyst) 0%, transparent 70%);\n    top: -100px;\n    right: -100px;\n  }\n\n  .orb-2 {\n    width: 500px;\n    height: 500px;\n    background: radial-gradient(circle, var(--indigo) 0%, transparent 70%);\n    bottom: -50px;\n    left: -50px;\n    animation-delay: -5s;\n  }\n\n  @keyframes move {\n    0% { transform: translate(0, 0) scale(1); }\n    100% { transform: translate(100px, 50px) scale(1.1); }\n  }\n\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n  }\n\n  .glow-purple {\n    box-shadow: 0 0 20px rgba(177, 75, 244, 0.3);\n  }\n\n  .gradient-btn {\n    background: linear-gradient(135deg, var(--amethyst) 0%, var(--indigo) 100%);\n    transition: all 0.3s ease;\n  }\n\n  .gradient-btn:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 20px rgba(75, 18, 254, 0.4);\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, #FFF 0%, #B14BF4 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n</style>\n\n<div class=\"relative min-h-screen flex\" data-kid=\"1\">\n  \n  <div class=\"orb orb-1\" data-kid=\"2\"></div>\n  <div class=\"orb orb-2\" data-kid=\"3\"></div>\n\n  \n  <aside class=\"w-72 glass-panel m-6 rounded-3xl p-8 flex flex-col gap-10\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3\" data-kid=\"5\">\n      <div class=\"w-10 h-10 rounded-xl gradient-btn flex items-center justify-center glow-purple\" data-kid=\"6\">\n        <i class=\"ti ti-bolt text-xl\" data-kid=\"7\"></i>\n      </div>\n      <span class=\"text-xl font-extrabold tracking-tight\" data-kid=\"8\">Click Marido</span>\n    </div>\n\n    <nav class=\"flex-1 flex flex-col gap-2\" data-kid=\"9\">\n      <div class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/10 border border-white/10\" data-kid=\"10\">\n        <i class=\"ti ti-layout text-amethyst\" data-kid=\"11\"></i>\n        <span class=\"font-bold\" data-kid=\"12\">Dashboard</span>\n      </div>\n      <div class=\"flex items-center gap-4 p-4 rounded-2xl hover:bg-white/5 transition-colors cursor-pointer text-white/60 hover:text-white\" data-kid=\"13\">\n        <i class=\"ti ti-users\" data-kid=\"14\"></i>\n        <span data-kid=\"15\">Clientes</span>\n      </div>\n      <div class=\"flex items-center gap-4 p-4 rounded-2xl hover:bg-white/5 transition-colors cursor-pointer text-white/60 hover:text-white\" data-kid=\"16\">\n        <i class=\"ti ti-shredder\" data-kid=\"17\"></i>\n        <span data-kid=\"18\">Serviços</span>\n      </div>\n      <div class=\"flex items-center gap-4 p-4 rounded-2xl hover:bg-white/5 transition-colors cursor-pointer text-white/60 hover:text-white\" data-kid=\"19\">\n        <i class=\"ti ti-photo-bolt\" data-kid=\"20\"></i>\n        <span data-kid=\"21\">Campanhas</span>\n      </div>\n    </nav>\n\n    <div class=\"p-4 rounded-2xl bg-gradient-to-br from-white/5 to-white/0 border border-white/10\" data-kid=\"22\">\n      <div class=\"flex items-center gap-3 mb-3\" data-kid=\"23\">\n        <div class=\"w-8 h-8 rounded-full bg-amethyst/20 flex items-center justify-center\" data-kid=\"24\">\n          <i class=\"ti ti-sparkles text-amethyst\" data-kid=\"25\"></i>\n        </div>\n        <span class=\"text-xs font-bold uppercase tracking-widest text-white/60\" data-kid=\"26\">AI Insights</span>\n      </div>\n      <p class=\"text-[11px] leading-relaxed text-white/40\" data-kid=\"27\">Sugerimos aumentar os anúncios em 'Marcenaria' hoje.</p>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 p-6 pl-0 flex flex-col gap-8\" data-kid=\"28\">\n    \n    <header class=\"flex justify-between items-center\" data-kid=\"29\">\n      <div class=\"space-y-1\" data-kid=\"30\">\n        <h1 class=\"text-3xl font-extrabold tracking-tight\" data-kid=\"31\">Painel <span class=\"text-gradient\" data-kid=\"32\">Executivo</span></h1>\n        <p class=\"text-white/40 text-sm\" data-kid=\"33\">Bem-vindo ao centro de comando da Click Marido.</p>\n      </div>\n      <button class=\"gradient-btn px-6 py-3 rounded-2xl font-bold flex items-center gap-2\" data-kid=\"34\">\n        <i class=\"ti ti-plus\" data-kid=\"35\"></i> Novo Lead\n      </button>\n    </header>\n\n    \n    <div class=\"grid grid-cols-3 gap-6\" data-kid=\"36\">\n      <div class=\"glass-panel p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"37\">\n        <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-amethyst/10 rounded-full blur-2xl group-hover:bg-amethyst/20 transition-all\" data-kid=\"38\"></div>\n        <div class=\"flex flex-col gap-4\" data-kid=\"39\">\n          <div class=\"flex justify-between items-center\" data-kid=\"40\">\n            <span class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"41\">Receita Prevista</span>\n            <i class=\"ti ti-brightness-2 text-amethyst\" data-kid=\"42\"></i>\n          </div>\n          <div class=\"text-4xl font-extrabold tracking-tighter\" data-kid=\"43\">R$ 42.5k</div>\n          <div class=\"text-xs text-emerald-400 font-bold\" data-kid=\"44\">+12.4% vs mês anterior</div>\n        </div>\n      </div>\n\n      <div class=\"glass-panel p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"45\">\n        <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-indigo/10 rounded-full blur-2xl group-hover:bg-indigo/20 transition-all\" data-kid=\"46\"></div>\n        <div class=\"flex flex-col gap-4\" data-kid=\"47\">\n          <div class=\"flex justify-between items-center\" data-kid=\"48\">\n            <span class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"49\">Leads Ativos</span>\n            <i class=\"ti ti-diamonds text-indigo\" data-kid=\"50\"></i>\n          </div>\n          <div class=\"text-4xl font-extrabold tracking-tighter\" data-kid=\"51\">1,284</div>\n          <div class=\"text-xs text-white/40 font-bold\" data-kid=\"52\">89 convertidos hoje</div>\n        </div>\n      </div>\n\n      <div class=\"glass-panel p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"53\">\n        <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-amethyst/10 rounded-full blur-2xl group-hover:bg-amethyst/20 transition-all\" data-kid=\"54\"></div>\n        <div class=\"flex flex-col gap-4\" data-kid=\"55\">\n          <div class=\"flex justify-between items-center\" data-kid=\"56\">\n            <span class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"57\">AI Score</span>\n            <i class=\"ti ti-cube-spark text-amethyst\" data-kid=\"58\"></i>\n          </div>\n          <div class=\"text-4xl font-extrabold tracking-tighter\" data-kid=\"59\">98.2%</div>\n          <div class=\"text-xs text-white/40 font-bold\" data-kid=\"60\">Saúde técnica excelente</div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-2 gap-6 flex-1\" data-kid=\"61\">\n      <div class=\"glass-panel rounded-3xl p-8 flex flex-col gap-6\" data-kid=\"62\">\n        <div class=\"flex justify-between items-center\" data-kid=\"63\">\n          <h3 class=\"font-bold\" data-kid=\"64\">Distribuição de Recursos</h3>\n          <i class=\"ti ti-macro text-white/20\" data-kid=\"65\"></i>\n        </div>\n        <div class=\"flex-1 flex items-center justify-center relative\" data-kid=\"66\">\n          \n          <svg width=\"240\" height=\"240\" viewBox=\"0 0 240 240\" class=\"drop-shadow-[0_0_15px_rgba(177,75,244,0.5)]\" data-kid=\"67\">\n            <polygon points=\"120,20 215,89 178,201 62,201 25,89\" fill=\"rgba(177, 75, 244, 0.2)\" stroke=\"#B14BF4\" stroke-width=\"2\" data-kid=\"68\"></polygon>\n            <polygon points=\"120,60 180,105 155,170 85,170 60,105\" fill=\"rgba(75, 18, 254, 0.2)\" stroke=\"#4B12FE\" stroke-width=\"2\" data-kid=\"69\"></polygon>\n            <circle cx=\"120\" cy=\"120\" r=\"100\" fill=\"none\" stroke=\"white\" stroke-width=\"0.5\" stroke-dasharray=\"4 4\" opacity=\"0.2\" data-kid=\"70\"></circle>\n          </svg>\n        </div>\n      </div>\n\n      <div class=\"glass-panel rounded-3xl overflow-hidden relative group\" data-kid=\"71\">\n        <video src=\"https://videos.pexels.com/video-files/34336884/14546149_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/34336884/pexels-photo-34336884.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover opacity-30\" data-kid=\"72\"></video>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-bg-cosmos via-transparent to-transparent\" data-kid=\"73\"></div>\n        <div class=\"relative z-10 p-8 h-full flex flex-col justify-end gap-2\" data-kid=\"74\">\n          <Badge class=\"bg-amethyst text-white w-fit px-3 py-1 rounded-full text-[10px] font-black uppercase mb-2\" data-kid=\"75\">Smart Action</Badge>\n          <h3 class=\"text-2xl font-extrabold tracking-tight\" data-kid=\"76\">Otimize a Conversão</h3>\n          <p class=\"text-sm text-white/60 leading-relaxed\" data-kid=\"77\">Nossa IA detectou uma oportunidade de +15% de margem em serviços de Elétrica.</p>\n          <button class=\"mt-4 w-fit px-6 py-2 rounded-xl bg-white text-bg-cosmos font-bold hover:bg-amethyst hover:text-white transition-all\" data-kid=\"78\">Ver Detalhes</button>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>",
