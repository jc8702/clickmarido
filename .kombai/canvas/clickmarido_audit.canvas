      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&display=swap');\n\n  :root {\n    --bg-main: #09090b;\n    --card-bg: rgba(18, 18, 21, 0.6);\n    --primary: #f59e0b; /* Default Amber */\n    --accent: #3b82f6;\n    --border: rgba(255, 255, 255, 0.05);\n  }\n\n  body {\n    font-family: 'Geist', sans-serif;\n    background-color: var(--bg-main);\n    color: #fafafa;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .glass-card {\n    background: var(--card-bg);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border);\n    border-radius: 1.25rem;\n    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .theme-card-active {\n    border-color: var(--primary);\n    box-shadow: 0 0 20px rgba(245, 158, 11, 0.15);\n  }\n\n  .glow-button {\n    background: var(--primary);\n    box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);\n  }\n\n  .color-swatch {\n    width: 2.5rem;\n    height: 2.5rem;\n    border-radius: 0.5rem;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .preview-orb {\n    position: absolute;\n    width: 300px;\n    height: 300px;\n    border-radius: 50%;\n    filter: blur(80px);\n    opacity: 0.15;\n    z-index: -1;\n  }\n\n  @keyframes pulse-soft {\n    0%, 100% { opacity: 0.1; }\n    50% { opacity: 0.2; }\n  }\n  .animate-pulse-soft {\n    animation: pulse-soft 4s infinite ease-in-out;\n  }\n</style>\n\n<div class=\"min-h-screen p-8 lg:p-16 relative overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"preview-orb bg-amber-500 top-[-100px] left-[-100px] animate-pulse-soft\" data-kid=\"2\"></div>\n  <div class=\"preview-orb bg-blue-600 bottom-[-100px] right-[-100px] animate-pulse-soft\" style=\"animation-delay: 2s;\" data-kid=\"3\"></div>\n\n  <div class=\"max-w-6xl mx-auto space-y-12\" data-kid=\"4\">\n    \n    <div class=\"space-y-2\" data-kid=\"5\">\n      <div class=\"flex items-center gap-2 text-zinc-500 mb-1\" data-kid=\"6\">\n        <span class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"7\">Dashboard</span>\n        <i class=\"fa-solid fa-chevron-right text-[10px]\" data-kid=\"8\"></i>\n        <span class=\"text-xs font-bold uppercase tracking-widest text-zinc-300\" data-kid=\"9\">Configurações</span>\n      </div>\n      <h1 class=\"text-4xl font-black tracking-tight text-white flex items-center gap-4\" data-kid=\"10\">\n        Aparência & Marca\n      </h1>\n      <p class=\"text-zinc-400 font-medium max-w-2xl text-lg\" data-kid=\"11\">\n        Personalize a experiência visual do Click Marido para alinhar com a identidade da sua empresa.\n      </p>\n    </div>\n\n    <div class=\"grid lg:grid-cols-3 gap-8\" data-kid=\"12\">\n      \n      <div class=\"lg:col-span-2 space-y-8\" data-kid=\"13\">\n        <section class=\"space-y-6\" data-kid=\"14\">\n          <div class=\"flex items-center justify-between\" data-kid=\"15\">\n            <h2 class=\"text-xl font-bold text-white flex items-center gap-2\" data-kid=\"16\">\n              <i class=\"fa-solid fa-palette text-amber-500\" data-kid=\"17\"></i>\n              Temas do Sistema\n            </h2>\n          </div>\n\n          <div class=\"grid sm:grid-cols-2 md:grid-cols-3 gap-4\" data-kid=\"18\">\n            \n            <button class=\"glass-card p-4 text-left group hover:border-purple-500/50 relative overflow-hidden\" data-kid=\"19\">\n              <div class=\"h-24 rounded-lg bg-gradient-to-br from-indigo-900 via-purple-900 to-indigo-950 mb-4 flex items-center justify-center\" data-kid=\"20\">\n                 <div class=\"w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/10 shadow-xl\" data-kid=\"21\"></div>\n              </div>\n              <h3 class=\"font-bold text-sm text-white\" data-kid=\"22\">Glassmorphism Purple</h3>\n              <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold\" data-kid=\"23\">Vibrant AI SaaS</p>\n            </button>\n\n            \n            <button class=\"glass-card p-4 text-left group hover:border-blue-400/50\" data-kid=\"24\">\n              <div class=\"h-24 rounded-lg bg-slate-50 mb-4 border border-zinc-200 flex items-center justify-center\" data-kid=\"25\">\n                 <div class=\"w-16 h-8 rounded-full bg-blue-100\" data-kid=\"26\"></div>\n              </div>\n              <h3 class=\"font-bold text-sm text-white\" data-kid=\"27\">Minimalist Arctic</h3>\n              <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold\" data-kid=\"28\">Scandi Clean</p>\n            </button>\n\n            \n            <button class=\"glass-card p-4 text-left group hover:border-emerald-500/50\" data-kid=\"29\">\n              <div class=\"h-24 rounded-lg bg-black mb-4 border border-zinc-800 flex items-center justify-center overflow-hidden relative\" data-kid=\"30\">\n                 <div class=\"absolute inset-0 opacity-20\" style=\"background-image: linear-gradient(0deg, transparent 24%, rgba(16, 185, 129, .05) 25%, rgba(16, 185, 129, .05) 26%, transparent 27%, transparent 74%, rgba(16, 185, 129, .05) 75%, rgba(16, 185, 129, .05) 76%, transparent 77%, transparent), linear-gradient(90deg, transparent 24%, rgba(16, 185, 129, .05) 25%, rgba(16, 185, 129, .05) 26%, transparent 27%, transparent 74%, rgba(16, 185, 129, .05) 75%, rgba(16, 185, 129, .05) 76%, transparent 77%, transparent); background-size: 20px 20px;\" data-kid=\"31\"></div>\n                 <span class=\"text-[10px] font-mono text-emerald-500 font-bold tracking-tighter\" data-kid=\"32\">> STATUS: OK</span>\n              </div>\n              <h3 class=\"font-bold text-sm text-white\" data-kid=\"33\">Cyberpunk Tech</h3>\n              <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold\" data-kid=\"34\">High Density</p>\n            </button>\n\n            \n            <button class=\"glass-card p-4 text-left group hover:border-orange-200/50\" data-kid=\"35\">\n              <div class=\"h-24 rounded-lg bg-[#FDFBF7] mb-4 border border-orange-100 flex items-center justify-center\" data-kid=\"36\">\n                 <div class=\"w-12 h-12 rounded-2xl bg-[#D4A373] rotate-12 shadow-sm\" data-kid=\"37\"></div>\n              </div>\n              <h3 class=\"font-bold text-sm text-white\" data-kid=\"38\">Warm Organic</h3>\n              <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold\" data-kid=\"39\">Japandi Nature</p>\n            </button>\n\n            \n            <button class=\"glass-card p-4 text-left theme-card-active relative\" data-kid=\"40\">\n              <div class=\"h-24 rounded-lg bg-[#F3F4F6] mb-4 border border-zinc-200 flex flex-col gap-2 p-3\" data-kid=\"41\">\n                 <div class=\"w-full h-2 rounded bg-blue-700\" data-kid=\"42\"></div>\n                 <div class=\"w-2/3 h-2 rounded bg-zinc-300\" data-kid=\"43\"></div>\n              </div>\n              <div class=\"flex justify-between items-center\" data-kid=\"44\">\n                <h3 class=\"font-bold text-sm text-white\" data-kid=\"45\">Corporate Blue</h3>\n                <i class=\"fa-solid fa-circle-check text-blue-500 text-xs\" data-kid=\"46\"></i>\n              </div>\n              <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold\" data-kid=\"47\">Enterprise Trust</p>\n            </button>\n\n            \n            <button class=\"glass-card p-4 border-dashed border-zinc-800 flex flex-col items-center justify-center gap-2 hover:border-zinc-600 transition-colors\" data-kid=\"48\">\n              <i class=\"fa-solid fa-plus text-zinc-600 text-xl\" data-kid=\"49\"></i>\n              <span class=\"text-xs font-bold text-zinc-500\" data-kid=\"50\">Criar Novo</span>\n            </button>\n          </div>\n        </section>\n\n        \n        <section class=\"space-y-6\" data-kid=\"51\">\n          <h2 class=\"text-xl font-bold text-white flex items-center gap-2\" data-kid=\"52\">\n            <i class=\"fa-solid fa-wand-magic-sparkles text-blue-500\" data-kid=\"53\"></i>\n            Logo & Color Sync\n          </h2>\n          \n          <div class=\"glass-card p-8 space-y-8\" data-kid=\"54\">\n            <div class=\"grid md:grid-cols-2 gap-12\" data-kid=\"55\">\n              <div class=\"space-y-4\" data-kid=\"56\">\n                <p class=\"text-sm text-zinc-400 font-medium\" data-kid=\"57\">Carregue sua logo e deixe o sistema extrair a paleta perfeita automaticamente.</p>\n                \n                <div class=\"h-48 rounded-2xl bg-zinc-950/50 border-2 border-dashed border-zinc-800 flex flex-col items-center justify-center gap-3 cursor-pointer hover:border-blue-500/30 hover:bg-blue-500/5 transition-all\" data-kid=\"58\">\n                  <div class=\"p-4 rounded-full bg-zinc-900 border border-zinc-800\" data-kid=\"59\">\n                    <i class=\"fa-solid fa-cloud-arrow-up text-zinc-500 text-2xl\" data-kid=\"60\"></i>\n                  </div>\n                  <div class=\"text-center\" data-kid=\"61\">\n                    <p class=\"text-xs font-bold text-white\" data-kid=\"62\">Solte sua Logo aqui</p>\n                    <p class=\"text-[10px] text-zinc-500 mt-1 uppercase tracking-widest\" data-kid=\"63\">SVG, PNG ou WebP</p>\n                  </div>\n                </div>\n\n                <button class=\"w-full h-11 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-lg shadow-blue-500/20 transition-all flex items-center justify-center gap-2\" data-kid=\"64\">\n                  <i class=\"fa-solid fa-sparkles\" data-kid=\"65\"></i>\n                  Extração Mágica\n                </button>\n              </div>\n\n              <div class=\"space-y-6\" data-kid=\"66\">\n                <div class=\"space-y-3\" data-kid=\"67\">\n                  <p class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest\" data-kid=\"68\">Cores Extraídas</p>\n                  <div class=\"flex flex-wrap gap-3\" data-kid=\"69\">\n                    <div class=\"space-y-2\" data-kid=\"70\">\n                      <div class=\"color-swatch bg-[#0F172A]\" data-kid=\"71\"></div>\n                      <p class=\"text-[9px] text-center font-bold text-zinc-500\" data-kid=\"72\">Main</p>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"73\">\n                      <div class=\"color-swatch bg-[#1E293B]\" data-kid=\"74\"></div>\n                      <p class=\"text-[9px] text-center font-bold text-zinc-500\" data-kid=\"75\">Card</p>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"76\">\n                      <div class=\"color-swatch bg-[#3B82F6]\" data-kid=\"77\"></div>\n                      <p class=\"text-[9px] text-center font-bold text-zinc-500\" data-kid=\"78\">Primary</p>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"79\">\n                      <div class=\"color-swatch bg-[#F59E0B]\" data-kid=\"80\"></div>\n                      <p class=\"text-[9px] text-center font-bold text-zinc-500\" data-kid=\"81\">Accent</p>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"p-4 rounded-xl bg-blue-500/10 border border-blue-500/20\" data-kid=\"82\">\n                  <div class=\"flex items-start gap-3\" data-kid=\"83\">\n                    <i class=\"fa-solid fa-circle-info text-blue-400 mt-0.5\" data-kid=\"84\"></i>\n                    <p class=\"text-xs text-blue-200 leading-relaxed\" data-kid=\"85\">\n                      <strong data-kid=\"86\">Dica:</strong> O sistema detectou cores frias na sua logo. Recomendamos o estilo <strong data-kid=\"87\">Enterprise Glass</strong> para melhor harmonia.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      </div>\n\n      \n      <div class=\"space-y-6\" data-kid=\"88\">\n        <h2 class=\"text-xl font-bold text-white flex items-center gap-2\" data-kid=\"89\">\n          <i class=\"fa-solid fa-desktop text-zinc-500\" data-kid=\"90\"></i>\n          Live Preview\n        </h2>\n\n        <div class=\"glass-card overflow-hidden sticky top-8\" data-kid=\"91\">\n          <div class=\"h-10 bg-zinc-950 border-b border-zinc-900 flex items-center px-4 gap-1.5\" data-kid=\"92\">\n            <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-800\" data-kid=\"93\"></div>\n            <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-800\" data-kid=\"94\"></div>\n            <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-800\" data-kid=\"95\"></div>\n            <div class=\"flex-1 text-center\" data-kid=\"96\">\n              <span class=\"text-[10px] font-bold text-zinc-600 tracking-tight\" data-kid=\"97\">clickmarido.crm/dashboard</span>\n            </div>\n          </div>\n\n          <div class=\"p-6 space-y-6 bg-zinc-950 relative\" data-kid=\"98\">\n             \n             <div class=\"absolute left-0 top-1/4 w-1 h-8 bg-blue-600 rounded-r-full shadow-[0_0_10px_rgba(37,99,235,0.4)]\" data-kid=\"99\"></div>\n             \n             \n             <div class=\"p-5 rounded-2xl bg-zinc-900/40 border border-white/5 space-y-4\" data-kid=\"100\">\n                <div class=\"flex justify-between items-center\" data-kid=\"101\">\n                  <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-widest\" data-kid=\"102\">Receita Total</span>\n                  <div class=\"p-1.5 rounded-lg bg-blue-500/10 text-blue-500\" data-kid=\"103\">\n                    <i class=\"fa-solid fa-chart-line text-xs\" data-kid=\"104\"></i>\n                  </div>\n                </div>\n                <div class=\"space-y-1\" data-kid=\"105\">\n                  <p class=\"text-2xl font-black text-white\" data-kid=\"106\">R$ 142