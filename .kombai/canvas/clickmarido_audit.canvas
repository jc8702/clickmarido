      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap');\n\n  :root {\n    --background: #050507;\n    --foreground: #ffffff;\n    --card: rgba(18, 18, 21, 0.75);\n    --primary: #3b82f6;\n    --accent: #a855f7;\n    --border: rgba(255, 255, 255, 0.06);\n  }\n\n  body {\n    font-family: 'Geist', sans-serif;\n    background-color: var(--background);\n    color: var(--foreground);\n    margin: 0;\n    overflow: hidden;\n  }\n\n  /* Tailwind v4 Utilities simulation */\n  .glass-panel {\n    background: var(--card);\n    backdrop-filter: blur(20px);\n    border-right: 1px solid var(--border);\n  }\n\n  .glass-card {\n    background: rgba(20, 20, 25, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border);\n    border-radius: 1.5rem;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .glass-card:hover {\n    background: rgba(25, 25, 30, 0.8);\n    border-color: rgba(59, 130, 246, 0.3);\n    box-shadow: 0 0 30px rgba(59, 130, 246, 0.1);\n  }\n\n  .glow-primary {\n    box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, #ffffff 0%, #6366f1 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .gradient-deep {\n    background: linear-gradient(135deg, #1e1b4b 0%, #020617 100%);\n    border: 1px solid rgba(99, 102, 241, 0.1);\n  }\n\n  .animate-slide-up {\n    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n  }\n\n  @keyframes slideUp {\n    from { opacity: 0; transform: translateY(20px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  .nav-item-active {\n    background: rgba(255, 255, 255, 0.05);\n    border-left: 3px solid #6366f1;\n    color: #fff;\n  }\n</style>\n\n<div class=\"flex h-screen w-full overflow-hidden\" data-kid=\"1\">\n  \n  <aside class=\"w-72 glass-panel flex flex-col z-20\" data-kid=\"2\">\n    <div class=\"p-8\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/20\" data-kid=\"5\">\n          <i class=\"fas fa-wrench text-white text-xl\" data-kid=\"6\"></i>\n        </div>\n        <div data-kid=\"7\">\n          <h1 class=\"text-xl font-black tracking-tighter\" data-kid=\"8\">CLICK MARIDO</h1>\n          <p class=\"text-[10px] text-indigo-400 font-mono tracking-widest uppercase\" data-kid=\"9\">Obsidian Edition</p>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 px-4 py-4 space-y-2\" data-kid=\"10\">\n      <div class=\"nav-item-active flex items-center gap-4 px-6 py-4 rounded-xl cursor-pointer\" data-kid=\"11\">\n        <i class=\"fas fa-chart-line text-indigo-400\" data-kid=\"12\"></i>\n        <span class=\"font-bold text-sm\" data-kid=\"13\">Dashboard</span>\n      </div>\n      <div class=\"flex items-center gap-4 px-6 py-4 rounded-xl text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer\" data-kid=\"14\">\n        <i class=\"fas fa-users\" data-kid=\"15\"></i>\n        <span class=\"font-bold text-sm\" data-kid=\"16\">Clientes</span>\n      </div>\n      <div class=\"flex items-center gap-4 px-6 py-4 rounded-xl text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer\" data-kid=\"17\">\n        <i class=\"fas fa-tools\" data-kid=\"18\"></i>\n        <span class=\"font-bold text-sm\" data-kid=\"19\">Serviços</span>\n      </div>\n      <div class=\"flex items-center gap-4 px-6 py-4 rounded-xl text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer\" data-kid=\"20\">\n        <i class=\"fas fa-file-invoice-dollar\" data-kid=\"21\"></i>\n        <span class=\"font-bold text-sm\" data-kid=\"22\">Orçamentos</span>\n      </div>\n    </nav>\n\n    <div class=\"p-8 space-y-6\" data-kid=\"23\">\n      <div class=\"p-4 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 flex items-center justify-between\" data-kid=\"24\">\n        <div class=\"flex items-center gap-2\" data-kid=\"25\">\n          <div class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"26\"></div>\n          <span class=\"text-[10px] font-mono text-zinc-400\" data-kid=\"27\">DB_NODE_01</span>\n        </div>\n        <span class=\"text-[9px] font-bold text-emerald-500 uppercase tracking-widest\" data-kid=\"28\">Active</span>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"29\">\n        <div class=\"w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-600 to-purple-600 p-0.5\" data-kid=\"30\">\n          <div class=\"w-full h-full rounded-full bg-zinc-950 flex items-center justify-center font-bold text-xs text-white\" data-kid=\"31\">CM</div>\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"32\">\n          <span class=\"text-sm font-bold\" data-kid=\"33\">Admin Obsidian</span>\n          <span class=\"text-[10px] text-zinc-500\" data-kid=\"34\">Master access</span>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 relative overflow-y-auto scrollbar-hide\" data-kid=\"35\">\n    \n    <div class=\"absolute top-[-100px] right-[-100px] w-[500px] h-[500px] bg-indigo-600/10 blur-[150px] -z-10 rounded-full\" data-kid=\"36\"></div>\n    <div class=\"absolute bottom-[-100px] left-[-100px] w-[500px] h-[500px] bg-purple-600/5 blur-[150px] -z-10 rounded-full\" data-kid=\"37\"></div>\n\n    <div class=\"p-12 space-y-12\" data-kid=\"38\">\n      \n      <header class=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-6 animate-slide-up\" data-kid=\"39\">\n        <div class=\"space-y-2\" data-kid=\"40\">\n          <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20\" data-kid=\"41\">\n            <span class=\"w-1.5 h-1.5 rounded-full bg-indigo-500\" data-kid=\"42\"></span>\n            <span class=\"text-[10px] font-bold text-indigo-400 uppercase tracking-widest\" data-kid=\"43\">Performance Insights</span>\n          </div>\n          <h2 class=\"text-5xl font-black tracking-tight\" data-kid=\"44\"><span class=\"gradient-text\" data-kid=\"45\">Deep View</span> Dashboard</h2>\n          <p class=\"text-zinc-500 font-medium text-lg\" data-kid=\"46\">Visão estratégica e faturamento de alto nível.</p>\n        </div>\n        <div class=\"flex gap-4\" data-kid=\"47\">\n          <button class=\"px-8 h-14 rounded-2xl bg-zinc-900 border border-zinc-800 text-sm font-bold hover:bg-zinc-850 transition-all\" data-kid=\"48\">Exportar Dados</button>\n          <button class=\"px-8 h-14 rounded-2xl bg-indigo-600 text-sm font-bold shadow-lg shadow-indigo-500/25 hover:bg-indigo-500 transition-all flex items-center gap-2\" data-kid=\"49\">\n            <i class=\"fas fa-plus\" data-kid=\"50\"></i> Novo Lead\n          </button>\n        </div>\n      </header>\n\n      \n      <section class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 animate-slide-up\" style=\"animation-delay: 0.1s\" data-kid=\"51\">\n        <div class=\"glass-card p-8 group\" data-kid=\"52\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"53\">\n            <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em]\" data-kid=\"54\">Receita Bruta</span>\n            <div class=\"p-2 rounded-xl bg-emerald-500/10 text-emerald-500\" data-kid=\"55\"><i class=\"fas fa-arrow-up\" data-kid=\"56\"></i></div>\n          </div>\n          <h3 class=\"text-3xl font-black text-white\" data-kid=\"57\">R$ 142.850</h3>\n          <p class=\"text-xs text-emerald-500 font-bold mt-2\" data-kid=\"58\">+12.5% <span class=\"text-zinc-600 font-medium\" data-kid=\"59\">este mês</span></p>\n        </div>\n\n        <div class=\"glass-card p-8 group\" data-kid=\"60\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"61\">\n            <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em]\" data-kid=\"62\">Conversão</span>\n            <div class=\"p-2 rounded-xl bg-indigo-500/10 text-indigo-500\" data-kid=\"63\"><i class=\"fas fa-percent\" data-kid=\"64\"></i></div>\n          </div>\n          <h3 class=\"text-3xl font-black text-white\" data-kid=\"65\">28.4%</h3>\n          <p class=\"text-xs text-indigo-500 font-bold mt-2\" data-kid=\"66\">+4.2% <span class=\"text-zinc-600 font-medium\" data-kid=\"67\">vs anterior</span></p>\n        </div>\n\n        <div class=\"glass-card p-8 group\" data-kid=\"68\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"69\">\n            <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em]\" data-kid=\"70\">Leads Ativos</span>\n            <div class=\"p-2 rounded-xl bg-purple-500/10 text-purple-500\" data-kid=\"71\"><i class=\"fas fa-users\" data-kid=\"72\"></i></div>\n          </div>\n          <h3 class=\"text-3xl font-black text-white\" data-kid=\"73\">1,284</h3>\n          <p class=\"text-xs text-purple-500 font-bold mt-2\" data-kid=\"74\">Funil <span class=\"text-zinc-600 font-medium\" data-kid=\"75\">em crescimento</span></p>\n        </div>\n\n        <div class=\"glass-card p-8 group\" data-kid=\"76\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"77\">\n            <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em]\" data-kid=\"78\">Qualidade Técnica</span>\n            <div class=\"p-2 rounded-xl bg-amber-500/10 text-amber-500\" data-kid=\"79\"><i class=\"fas fa-shield-check\" data-kid=\"80\"></i></div>\n          </div>\n          <h3 class=\"text-3xl font-black text-white\" data-kid=\"81\">98.2%</h3>\n          <p class=\"text-xs text-amber-500 font-bold mt-2\" data-kid=\"82\">Zero <span class=\"text-zinc-600 font-medium\" data-kid=\"83\">garantias abertas</span></p>\n        </div>\n      </section>\n\n      \n      <section class=\"grid grid-cols-1 lg:grid-cols-2 gap-8 animate-slide-up\" style=\"animation-delay: 0.2s\" data-kid=\"84\">\n        <div class=\"gradient-deep rounded-[2.5rem] p-12 relative overflow-hidden group\" data-kid=\"85\">\n          <div class=\"absolute right-[-20px] bottom-[-20px] opacity-10 group-hover:scale-110 transition-transform duration-700\" data-kid=\"86\">\n             <i class=\"fas fa-chart-pie text-[15rem] text-indigo-400\" data-kid=\"87\"></i>\n          </div>\n          <div class=\"relative z-10 space-y-6\" data-kid=\"88\">\n            <span class=\"px-4 py-1.5 rounded-full bg-indigo-500/20 text-indigo-400 font-bold text-[10px] uppercase tracking-widest border border-indigo-500/30\" data-kid=\"89\">Financeiro</span>\n            <h3 class=\"text-4xl font-black max-w-sm leading-tight\" data-kid=\"90\">Análise de Fluxo e Margem de Lucro</h3>\n            <p class=\"text-zinc-500 max-w-xs font-medium\" data-kid=\"91\">Relatórios detalhados com inteligência de dados preditiva.</p>\n            <button class=\"h-14 px-8 rounded-2xl bg-indigo-600 text-sm font-bold mt-4 hover:bg-indigo-500 transition-all\" data-kid=\"92\">Abrir Relatório</button>\n          </div>\n        </div>\n\n        <div class=\"gradient-deep rounded-[2.5rem] p-12 relative overflow-hidden group\" data-kid=\"93\">\n          <div class=\"absolute right-[-20px] bottom-[-20px] opacity-10 group-hover:scale-110 transition-transform duration-700\" data-kid=\"94\">\n             <i class=\"fas fa-file-invoice text-[15rem] text-purple-400\" data-kid=\"95\"></i>\n          </div>\n          <div class=\"relative z-10 space-y-6\" data-kid=\"96\">\n            <span class=\"px-4 py-1.5 rounded-full bg-purple-500/20 text-purple-400 font-bold text-[10px] uppercase tracking-widest border border-purple-500/30\" data-kid=\"97\">Comercial</span>\n            <h3 class=\"text-4xl font-black max-w-sm leading-tight\" data-kid=\"98\">Gestão Global de Orçamentos</h3>\n            <p class=\"text-zinc-500 max-w-xs font-medium\" data-kid=\"99\">Acompanhe o funil comercial e as taxas de fechamento.</p>\n            <button class=\"h-14 px-8 rounded-2xl bg-purple-600 text-sm font-bold mt-4 hover:bg-purple-500 transition-all\" data-kid=\"100\">Gerir Pipeline</button>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"space-y-8 animate-slide-up\" style=\"animation-delay: 0.3s\" data-kid=\"101\">\n        <div class=\"flex items-center gap-4\" data-kid=\"102\">\n          <div class=\"p-3 rounded-2xl bg-zinc-900 border border-zinc-800\" data-kid=\"103\"><i class=\"fas fa-history text-zinc-400\" data-kid=\"104\"></i></div>\n          <h3 class=\"text-2xl font-black tracking-tight\" data-kid=\"105\">Atividade do Sistema</h3>\n        </div>\n\n        <div class=\"space-y-4\" data-kid=\"106\">\n          <div class=\"glass-card p-6 flex items-center justify-between group\" data-kid=\"107\">\n            <div class=\"flex items-center gap-6\" data-kid=\"108\">\n              <div class=\"w-14 h-14 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600 group-hover:text-indigo-500 transition-colors\" data-kid=\"109\">\n                <i class=\"fas fa-plus-circle text-xl\" data-kid=\"110\"></i>\n              </div>\n              <div data-kid=\"111\">\n                <h4 class=\"font-bold text-white\" data-kid=\"112\">Novo Lead Adicionado</h4>\n                <p class=\"text-xs text-zinc-500 mt-1 font-medium\" data-kid=\"113\">Cliente: <span class=\"text-zinc-300\" data-kid=\"114\">João da Silva</span> • Origem: <span class=\"text-indigo-400\" data-kid=\"115\">WhatsApp</span></p>\n              </div>\n            </div>\n            <div class=\"text-right hidden md:block\" data-kid=\"116\">\n              <p class=\"text-[10px] font-mono text-zinc-600 uppercase tracking-widest\" data-kid=\"117\">Aguardando Contato</p>\n              <p class=\"text-xs font-bold text-zinc-400 mt-1\" data-kid=\"118\">HÁ 12 MINUTOS</p>\n            </div>\n          </div>\n\n          <div class=\"glass-card p-6 flex items-center justify-between group\" data-kid=\"119\">\n            <div class=\"flex items-center gap-6\" data-kid=\"120\">\n              <div class=\"w-14 h-14 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600 group-hover:text-emerald-500 transition-colors\" data-kid=\"121\">\n                <i class=\"fas fa-check-double text-xl\" data-kid=\"122\"></i>\n              </div>\n              <div data-kid=\"123\">\n                <h4 class=\"font-bold text-white\" data-kid=\"124\">Orçamento Aprovado</h4>\n                <p class=\"text-xs text-zinc-500 mt-1 font-medium\" data-kid=\"125\">Serviço: <span class=\"text-zinc-300\" data-kid=\"126\">Reforma Elétrica</span> • Valor: <span class=\"text-emerald-500\" data-kid=\"127\">R$ 4.250</span></p>\n              </div>\n            </div>\n            <div class=\"text-right hidden md:block\" data-kid=\"128\">\n              <p class=\"text-[10px] font-mono text-emerald-500 uppercase tracking-widest\" data-kid=\"129\">Confirmado</p>\n              <p class=\"text-xs font-bold text-zinc-400 mt-1\" data-kid=\"130\">HÁ 45 MINUTOS</p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  </main>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" data-kid=\"131\">",
