      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-cyber: #050505;\n    --fg-cyber: #e0e0e0;\n    --neon-green: #00ffa3;\n    --cyber-pink: #ff003c;\n    --terminal-black: rgba(15, 15, 20, 0.95);\n  }\n\n  body {\n    background-color: var(--bg-cyber);\n    color: var(--fg-cyber);\n    font-family: 'JetBrains+Mono', monospace;\n    margin: 0;\n    padding: 0;\n    overflow-x: hidden;\n    position: relative;\n  }\n\n  /* Scanline Overlay Effect */\n  body::before {\n    content: \" \";\n    display: block;\n    position: fixed;\n    top: 0;\n    left: 0;\n    bottom: 0;\n    right: 0;\n    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));\n    z-index: 1000;\n    background-size: 100% 2px, 3px 100%;\n    pointer-events: none;\n  }\n\n  .cyber-border {\n    border: 1px solid var(--neon-green);\n    position: relative;\n    background: var(--terminal-black);\n    box-shadow: 0 0 15px rgba(0, 255, 163, 0.1);\n  }\n\n  .cyber-border::after {\n    content: \"\";\n    position: absolute;\n    bottom: -2px;\n    right: -2px;\n    width: 10px;\n    height: 10px;\n    background: var(--neon-green);\n    clip-path: polygon(100% 0, 100% 100%, 0 100%);\n  }\n\n  .glow-text-green {\n    color: var(--neon-green);\n    text-shadow: 0 0 8px rgba(0, 255, 163, 0.6);\n  }\n\n  .glow-text-pink {\n    color: var(--cyber-pink);\n    text-shadow: 0 0 8px rgba(255, 0, 60, 0.6);\n  }\n\n  .matrix-grid {\n    background-image: \n      linear-gradient(to right, rgba(0, 255, 163, 0.05) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(0, 255, 163, 0.05) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 8px;\n    height: 16px;\n    background: var(--neon-green);\n    animation: blink 1s step-end infinite;\n    vertical-align: middle;\n  }\n</style>\n\n<div class=\"min-h-screen flex matrix-grid\" data-kid=\"1\">\n  \n  <aside class=\"w-64 border-r border-(--neon-green)/30 bg-black/80 flex flex-col z-50\" data-kid=\"2\">\n    <div class=\"p-6 border-b border-(--neon-green)/30\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 border border-(--neon-green) flex items-center justify-center glow-text-green\" data-kid=\"5\">\n          <i class=\"ti ti-terminal text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <div data-kid=\"7\">\n          <h1 class=\"text-sm font-extrabold tracking-tighter glow-text-green\" data-kid=\"8\">CLICK_MARIDO</h1>\n          <p class=\"text-[9px] text-(--neon-green)/60 uppercase font-bold tracking-widest\" data-kid=\"9\">v4.0.Terminal</p>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 p-4 space-y-2 mt-4\" data-kid=\"10\">\n      <div class=\"text-[10px] text-(--neon-green)/40 mb-4 tracking-widest\" data-kid=\"11\">[ CORE_NAVIGATION ]</div>\n      <a href=\"#\" class=\"flex items-center gap-3 p-3 border border-(--neon-green) bg-(--neon-green)/10 text-(--neon-green) text-xs font-bold uppercase tracking-widest\" data-kid=\"12\">\n        <i class=\"ti ti-layout-2-filled\" data-kid=\"13\"></i> DASHBOARD\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 p-3 border border-transparent hover:border-(--neon-green)/30 text-(--fg-cyber)/60 hover:text-(--neon-green) text-xs font-bold uppercase tracking-widest transition-all\" data-kid=\"14\">\n        <i class=\"ti ti-users\" data-kid=\"15\"></i> CLIENTS_BASE\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 p-3 border border-transparent hover:border-(--neon-green)/30 text-(--fg-cyber)/60 hover:text-(--neon-green) text-xs font-bold uppercase tracking-widest transition-all\" data-kid=\"16\">\n        <i class=\"ti ti-activity\" data-kid=\"17\"></i> SERVICE_LOGS\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 p-3 border border-transparent hover:border-(--neon-green)/30 text-(--fg-cyber)/60 hover:text-(--neon-green) text-xs font-bold uppercase tracking-widest transition-all\" data-kid=\"18\">\n        <i class=\"ti ti-chart-pie\" data-kid=\"19\"></i> FINANCIAL_DEPT\n      </a>\n    </nav>\n\n    <div class=\"p-6 border-t border-(--neon-green)/30 space-y-4\" data-kid=\"20\">\n      <div class=\"p-3 bg-red-950/20 border border-red-500/30\" data-kid=\"21\">\n        <div class=\"flex items-center gap-2 text-[10px] glow-text-pink font-black\" data-kid=\"22\">\n          <i class=\"ti ti-shield-x\" data-kid=\"23\"></i> SYSTEM_ALERT\n        </div>\n        <p class=\"text-[9px] text-red-400 mt-1 uppercase\" data-kid=\"24\">3 pending_warranties detected</p>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 overflow-y-auto p-10 relative\" data-kid=\"25\">\n    \n    <header class=\"mb-12\" data-kid=\"26\">\n      <div class=\"flex justify-between items-end mb-4\" data-kid=\"27\">\n        <div data-kid=\"28\">\n          <div class=\"text-[10px] text-(--neon-green) mb-2 font-black uppercase tracking-[0.3em]\" data-kid=\"29\">> EXECUTING: VIEW_DASHBOARD</div>\n          <h2 class=\"text-4xl font-extrabold text-white tracking-tighter\" data-kid=\"30\">TERMINAL_READOUT<span class=\"cursor-blink\" data-kid=\"31\"></span></h2>\n        </div>\n        <div class=\"flex gap-4\" data-kid=\"32\">\n          <button class=\"px-6 py-2 border border-(--neon-green) bg-(--neon-green) text-black font-black text-xs uppercase tracking-widest hover:bg-transparent hover:text-(--neon-green) transition-all\" data-kid=\"33\">\n            [ ADD_DATA_POINT ]\n          </button>\n        </div>\n      </div>\n      <div class=\"h-px bg-(--neon-green)/20 w-full\" data-kid=\"34\"></div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-4 gap-6 mb-12\" data-kid=\"35\">\n      <div class=\"cyber-border p-6 group transition-all hover:bg-(--neon-green)/5\" data-kid=\"36\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"37\">\n          <span class=\"text-[10px] font-black text-(--neon-green)/60 uppercase tracking-widest\" data-kid=\"38\">TOTAL_LEADS</span>\n          <i class=\"ti ti-users text-(--neon-green) text-xl\" data-kid=\"39\"></i>\n        </div>\n        <div class=\"text-4xl font-black glow-text-green tracking-tighter\" data-kid=\"40\">2,482</div>\n        <div class=\"mt-4 flex items-center gap-2 text-[10px] text-(--neon-green)/40\" data-kid=\"41\">\n          <i class=\"ti ti-trending-up-3 text-(--neon-green)\" data-kid=\"42\"></i> +12% VS_PREV_MONTH\n        </div>\n      </div>\n\n      <div class=\"cyber-border p-6 group transition-all hover:bg-(--neon-green)/5\" data-kid=\"43\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"44\">\n          <span class=\"text-[10px] font-black text-(--neon-green)/60 uppercase tracking-widest\" data-kid=\"45\">CONV_RATE</span>\n          <i class=\"ti ti-transfer text-(--neon-green) text-xl\" data-kid=\"46\"></i>\n        </div>\n        <div class=\"text-4xl font-black glow-text-green tracking-tighter\" data-kid=\"47\">84.2%</div>\n        <div class=\"mt-4 flex items-center gap-2 text-[10px] glow-text-pink\" data-kid=\"48\">\n          <i class=\"ti ti-mood-neutral\" data-kid=\"49\"></i> STABLE_REVENUE_FLOW\n        </div>\n      </div>\n\n      <div class=\"cyber-border p-6 group transition-all hover:bg-(--neon-green)/5\" data-kid=\"50\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"51\">\n          <span class=\"text-[10px] font-black text-(--neon-green)/60 uppercase tracking-widest\" data-kid=\"52\">REVENUE_BRUT</span>\n          <i class=\"ti ti-coins text-(--neon-green) text-xl\" data-kid=\"53\"></i>\n        </div>\n        <div class=\"text-4xl font-black glow-text-green tracking-tighter\" data-kid=\"54\">R$42.5K</div>\n        <div class=\"mt-4 flex items-center gap-2 text-[10px] text-(--neon-green)/40\" data-kid=\"55\">\n          <i class=\"ti ti-activity text-(--neon-green)\" data-kid=\"56\"></i> PEAK_PERFORMANCE_MET\n        </div>\n      </div>\n\n      <div class=\"cyber-border p-6 group transition-all hover:bg-(--neon-green)/5\" data-kid=\"57\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"58\">\n          <span class=\"text-[10px] font-black text-(--neon-green)/60 uppercase tracking-widest\" data-kid=\"59\">ACTIVE_UNITS</span>\n          <i class=\"ti ti-building-airport text-(--neon-green) text-xl\" data-kid=\"60\"></i>\n        </div>\n        <div class=\"text-4xl font-black glow-text-green tracking-tighter\" data-kid=\"61\">18/22</div>\n        <div class=\"mt-4 flex items-center gap-2 text-[10px] text-(--neon-green)/40\" data-kid=\"62\">\n          <i class=\"ti ti-adjustments-up text-(--neon-green)\" data-kid=\"63\"></i> OPS_CAPACITY: 82%\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-3 gap-8\" data-kid=\"64\">\n      \n      <div class=\"col-span-2 cyber-border p-8 overflow-hidden\" data-kid=\"65\">\n        <div class=\"flex justify-between items-center mb-10\" data-kid=\"66\">\n          <h3 class=\"text-xs font-black uppercase tracking-[0.3em] glow-text-green\" data-kid=\"67\">[ PERFORMANCE_VELOCITY_MATRIX ]</h3>\n          <div class=\"flex gap-2\" data-kid=\"68\">\n            <span class=\"w-3 h-3 border border-(--cyber-pink) bg-(--cyber-pink)/20\" data-kid=\"69\"></span>\n            <span class=\"text-[9px] text-(--fg-cyber)/60 font-bold uppercase tracking-widest\" data-kid=\"70\">PROJECT_ALPHA_STREAK</span>\n          </div>\n        </div>\n        \n        \n        <div class=\"h-64 relative flex items-end gap-1\" data-kid=\"71\">\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[40%]\" data-kid=\"72\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[40%]\" data-kid=\"73\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[60%]\" data-kid=\"74\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[60%]\" data-kid=\"75\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[55%]\" data-kid=\"76\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[80%]\" data-kid=\"77\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[80%]\" data-kid=\"78\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[95%]\" data-kid=\"79\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[70%]\" data-kid=\"80\"></div>\n          <div class=\"flex-1 bg-(--cyber-pink)/30 border-t-2 border-(--cyber-pink) hover:bg-(--cyber-pink)/50 transition-all h-[90%]\" data-kid=\"81\"></div>\n        </div>\n        \n        \n        <div class=\"flex justify-between mt-4 text-[9px] font-bold text-(--neon-green)/30 uppercase tracking-[0.2em]\" data-kid=\"82\">\n          <span data-kid=\"83\">T-MINUS 12D</span>\n          <span data-kid=\"84\">T-MINUS 8D</span>\n          <span data-kid=\"85\">T-MINUS 4D</span>\n          <span data-kid=\"86\">SYSTEM_NOW</span>\n        </div>\n      </div>\n\n      \n      <div class=\"cyber-border flex flex-col bg-black/40\" data-kid=\"87\">\n        <div class=\"p-4 border-b border-(--neon-green)/30\" data-kid=\"88\">\n          <h3 class=\"text-xs font-black uppercase tracking-[0.2em] text-(--neon-green)\" data-kid=\"89\">[ SYSTEM_LIVE_FEED ]</h3>\n        </div>\n        <div class=\"flex-1 p-4 space-y-4 overflow-y-auto\" data-kid=\"90\">\n          <div class=\"font-bold\" data-kid=\"91\">\n            <div class=\"flex justify-between text-[9px] text-(--neon-green)/40 mb-1 font-mono\" data-kid=\"92\">\n              <span data-kid=\"93\">08:42:12.42MS</span>\n              <span data-kid=\"94\">AUTH:OK</span>\n            </div>\n            <p class=\"text-[10px] text-(--neon-green)/80 uppercase tracking-widest\" data-kid=\"95\">> CLIENT_LOGIN: JOAO_SILVA [IP_REDACTED]</p>\n          </div>\n\n          <div class=\"font-bold\" data-kid=\"96\">\n            <div class=\"flex justify-between text-[9px] text-(--neon-green)/40 mb-1 font-mono\" data-kid=\"97\">\n              <span data-kid=\"98\">08:42:01.05MS</span>\n              <span data-kid=\"99\">DB:SYNC</span>\n            </div>\n            <p class=\"text-[10px] text-(--neon-green)/80 uppercase tracking-widest\" data-kid=\"100\">> QUOTE_GENERATED: #ORC-984 [R$1,450.00]</p>\n          </div>\n\n          <div class=\"font-bold\" data-kid=\"101\">\n            <div class=\"flex justify-between text-[9px] text-red-400/40 mb-1 font-mono\" data-kid=\"102\">\n              <span data-kid=\"103\">08:41:55.12MS</span>\n              <span data-kid=\"104\">WARN:SYS</span>\n            </div>\n            <p class=\"text-[10px] text-red-400 uppercase tracking-widest\" data-kid=\"105\">> WARRANTY_ALERT: TECH_04 [EXPIRING_IN_24H]</p>\n          </div>\n\n          <div class=\"font-bold\" data-kid=\"106\">\n            <div class=\"flex justify-between text-[9px] text-(--neon-green)/40 mb-1 font-mono\" data-kid=\"107\">\n              <span data-kid=\"108\">08:41:30.88MS</span>\n              <span data-kid=\"109\">SMS:SENT</span>\n            </div>\n            <p class=\"text-[10px] text-(--neon-green)/80 uppercase tracking-widest\" data-kid=\"110\">> WHATSAPP_CALLBACK_TRIGGERED [QUEUE_EMPTY]</p>\n          </div>\n\n          <div class=\"font-bold\" data-kid=\"111\">\n            <div class=\"flex justify-between text-[9px] text-(--neon-green)/40 mb-1 font-mono\" data-kid=\"112\">\n              <span data-kid=\"113\">08:41:12.01MS</span>\n              <span data-kid=\"114\">CORE:OK</span>\n            </div>\n            <p class=\"text-[10px] text-(--neon-green)/80 uppercase tracking-widest\" data-kid=\"115\">> PERIODIC_REVENUE_AUDIT_COMPLETE [MARGIN_NOMINAL]</p>\n          </div>\n        </div>\n        <div class=\"p-3 bg-(--neon-green)/5 text-[9px] text-(--neon-green)/40 text-center font-bold tracking-widest italic\" data-kid=\"116\">\n          -- END_OF_BUFFER --\n        </div>\n      </div>\n    </div>\n  </main>\n</div>",
