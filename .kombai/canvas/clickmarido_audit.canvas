    "var_fd42bb63307d": {
      "type": "variant",
      "label": "Dashboard - Warm Wood/Nature",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-warm: #FDFBF7;\n    --text-espresso: #4A3F35;\n    --accent-oak: #D4A373;\n    --accent-sage: #CCD5AE;\n    --card-white: #FFFFFF;\n    --shadow-warm: 0 10px 40px rgba(74, 63, 53, 0.05);\n  }\n\n  body {\n    background-color: var(--bg-warm);\n    color: var(--text-espresso);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    margin: 0;\n    padding: 0;\n  }\n\n  .font-serif { font-family: 'Lora', serif; }\n\n  .glass-card {\n    background: var(--card-white);\n    border: 1px solid rgba(212, 163, 115, 0.1);\n    box-shadow: var(--shadow-warm);\n    border-radius: 2rem;\n  }\n\n  .btn-primary {\n    background-color: var(--accent-oak);\n    color: white;\n    border-radius: 1rem;\n    transition: all 0.3s ease;\n  }\n  .btn-primary:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 4px 15px rgba(212, 163, 115, 0.3);\n  }\n\n  .sidebar-item {\n    transition: all 0.2s ease;\n    border-radius: 1rem;\n  }\n  .sidebar-item:hover {\n    background-color: rgba(212, 163, 115, 0.1);\n    color: var(--accent-oak);\n  }\n  .sidebar-item.active {\n    background-color: var(--accent-oak);\n    color: white;\n  }\n\n  .blob-bg {\n    position: absolute;\n    filter: blur(80px);\n    z-index: -1;\n    opacity: 0.4;\n  }\n</style>\n\n<div class=\"flex h-screen overflow-hidden relative\" data-kid=\"1\">\n  \n  <div class=\"blob-bg w-96 h-96 bg-[#CCD5AE] top-[-10%] right-[-5%]\" data-kid=\"2\"></div>\n  <div class=\"blob-bg w-80 h-80 bg-[#D4A373] bottom-[10%] left-[-5%]\" data-kid=\"3\"></div>\n\n  \n  <aside class=\"w-72 bg-white/40 backdrop-blur-xl border-r border-[#4A3F35]/5 flex flex-col p-8\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3 mb-12\" data-kid=\"5\">\n      <div class=\"w-10 h-10 bg-[#D4A373] rounded-2xl flex items-center justify-center text-white\" data-kid=\"6\">\n        <i class=\"ti ti-leaf text-2xl\" data-kid=\"7\"></i>\n      </div>\n      <div data-kid=\"8\">\n        <h1 class=\"font-serif text-xl font-bold tracking-tight\" data-kid=\"9\">Click Marido</h1>\n        <p class=\"text-[10px] uppercase tracking-widest opacity-50 font-bold\" data-kid=\"10\">Nature Edition</p>\n      </div>\n    </div>\n\n    <nav class=\"flex-1 space-y-2\" data-kid=\"11\">\n      <div class=\"text-[10px] uppercase tracking-[0.2em] font-bold opacity-30 mb-4 px-4\" data-kid=\"12\">Menu</div>\n      <a href=\"#\" class=\"sidebar-item active flex items-center gap-3 px-4 py-3 text-sm font-semibold\" data-kid=\"13\">\n        <i class=\"ti ti-smart-home text-lg\" data-kid=\"14\"></i> Dashboard\n      </a>\n      <a href=\"#\" class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-60\" data-kid=\"15\">\n        <i class=\"ti ti-users text-lg\" data-kid=\"16\"></i> Clientes\n      </a>\n      <a href=\"#\" class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-60\" data-kid=\"17\">\n        <i class=\"ti ti-briefcase text-lg\" data-kid=\"18\"></i> Serviços\n      </a>\n      <a href=\"#\" class=\"sidebar-item flex items-center gap-3 px-4 py-3 text-sm font-semibold opacity-60\" data-kid=\"19\">\n        <i class=\"ti ti-file-text text-lg\" data-kid=\"20\"></i> Orçamentos\n      </a>\n    </nav>\n\n    <div class=\"mt-auto p-4 rounded-3xl bg-[#D4A373]/5 border border-[#D4A373]/10\" data-kid=\"21\">\n      <div class=\"flex items-center gap-3 mb-3\" data-kid=\"22\">\n        <div class=\"w-8 h-8 rounded-full bg-[#CCD5AE] flex items-center justify-center\" data-kid=\"23\">\n          <i class=\"ti ti-plant text-[#4A3F35]\" data-kid=\"24\"></i>\n        </div>\n        <span class=\"text-xs font-bold\" data-kid=\"25\">Ecossistema Ativo</span>\n      </div>\n      <p class=\"text-[10px] leading-relaxed opacity-60\" data-kid=\"26\">Sua operação está rodando em harmonia com Supabase Cloud.</p>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 overflow-y-auto p-12\" data-kid=\"27\">\n    <header class=\"flex justify-between items-end mb-12\" data-kid=\"28\">\n      <div class=\"space-y-2\" data-kid=\"29\">\n        <h2 class=\"font-serif text-4xl font-bold\" data-kid=\"30\">Bom dia, Administrador</h2>\n        <p class=\"text-lg opacity-50\" data-kid=\"31\">Respire fundo. Aqui está o pulso da sua empresa hoje.</p>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"32\">\n        <button class=\"px-6 py-3 border border-[#4A3F35]/10 rounded-2xl font-bold text-sm hover:bg-white transition-all\" data-kid=\"33\">\n          <i class=\"ti ti-download mr-2\" data-kid=\"34\"></i> Relatórios\n        </button>\n        <button class=\"btn-primary px-8 py-3 font-bold text-sm shadow-lg\" data-kid=\"35\">\n          <i class=\"ti ti-plus mr-2\" data-kid=\"36\"></i> Novo Registro\n        </button>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-4 gap-6 mb-12\" data-kid=\"37\">\n      <div class=\"glass-card p-8\" data-kid=\"38\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"39\">\n          <div class=\"p-3 bg-[#CCD5AE]/20 rounded-2xl text-[#4A3F35]\" data-kid=\"40\">\n            <i class=\"ti ti-users text-xl\" data-kid=\"41\"></i>\n          </div>\n          <span class=\"text-xs font-bold text-emerald-600\" data-kid=\"42\">+12%</span>\n        </div>\n        <h3 class=\"text-[10px] uppercase tracking-widest font-bold opacity-40 mb-1\" data-kid=\"43\">Total de Leads</h3>\n        <p class=\"font-serif text-3xl font-bold\" data-kid=\"44\">1,284</p>\n      </div>\n\n      <div class=\"glass-card p-8\" data-kid=\"45\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"46\">\n          <div class=\"p-3 bg-[#D4A373]/20 rounded-2xl text-[#D4A373]\" data-kid=\"47\">\n            <i class=\"ti ti-file-analytics text-xl\" data-kid=\"48\"></i>\n          </div>\n          <span class=\"text-xs font-bold text-emerald-600\" data-kid=\"49\">+5%</span>\n        </div>\n        <h3 class=\"text-[10px] uppercase tracking-widest font-bold opacity-40 mb-1\" data-kid=\"50\">Orçamentos</h3>\n        <p class=\"font-serif text-3xl font-bold\" data-kid=\"51\">452</p>\n      </div>\n\n      <div class=\"glass-card p-8\" data-kid=\"52\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"53\">\n          <div class=\"p-3 bg-[#CCD5AE]/20 rounded-2xl text-[#4A3F35]\" data-kid=\"54\">\n            <i class=\"ti ti-currency-dollar text-xl\" data-kid=\"55\"></i>\n          </div>\n          <span class=\"text-xs font-bold text-emerald-600\" data-kid=\"56\">+18%</span>\n        </div>\n        <h3 class=\"text-[10px] uppercase tracking-widest font-bold opacity-40 mb-1\" data-kid=\"57\">Faturamento</h3>\n        <p class=\"font-serif text-3xl font-bold\" data-kid=\"58\">R$ 42.5k</p>\n      </div>\n\n      <div class=\"glass-card p-8 border-2 border-[#D4A373]/20 bg-[#FDFBF7]/50\" data-kid=\"59\">\n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"60\">\n          <div class=\"p-3 bg-[#D4A373] rounded-2xl text-white\" data-kid=\"61\">\n            <i class=\"ti ti-chart-pie text-xl\" data-kid=\"62\"></i>\n          </div>\n          <i class=\"ti ti-dots text-zinc-300\" data-kid=\"63\"></i>\n        </div>\n        <h3 class=\"text-[10px] uppercase tracking-widest font-bold opacity-40 mb-1\" data-kid=\"64\">Conversão</h3>\n        <p class=\"font-serif text-3xl font-bold\" data-kid=\"65\">64.2%</p>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-3 gap-8\" data-kid=\"66\">\n      <div class=\"col-span-2 glass-card p-10\" data-kid=\"67\">\n        <div class=\"flex justify-between items-center mb-10\" data-kid=\"68\">\n          <h4 class=\"font-serif text-2xl font-bold\" data-kid=\"69\">Crescimento Sustentável</h4>\n          <div class=\"flex gap-2\" data-kid=\"70\">\n            <span class=\"px-3 py-1 bg-[#CCD5AE]/20 rounded-full text-[10px] font-bold\" data-kid=\"71\">Mensal</span>\n            <span class=\"px-3 py-1 hover:bg-zinc-100 rounded-full text-[10px] font-bold cursor-pointer\" data-kid=\"72\">Anual</span>\n          </div>\n        </div>\n        \n        <div class=\"h-64 flex items-end gap-3 px-4\" data-kid=\"73\">\n          <div class=\"flex-1 bg-[#CCD5AE]/30 rounded-t-2xl h-[40%]\" data-kid=\"74\"></div>\n          <div class=\"flex-1 bg-[#D4A373]/40 rounded-t-2xl h-[60%]\" data-kid=\"75\"></div>\n          <div class=\"flex-1 bg-[#CCD5AE]/30 rounded-t-2xl h-[45%]\" data-kid=\"76\"></div>\n          <div class=\"flex-1 bg-[#D4A373]/40 rounded-t-2xl h-[75%]\" data-kid=\"77\"></div>\n          <div class=\"flex-1 bg-[#CCD5AE]/30 rounded-t-2xl h-[55%]\" data-kid=\"78\"></div>\n          <div class=\"flex-1 bg-[#D4A373] rounded-t-2xl h-[90%]\" data-kid=\"79\"></div>\n          <div class=\"flex-1 bg-[#CCD5AE]/30 rounded-t-2xl h-[65%]\" data-kid=\"80\"></div>\n        </div>\n      </div>\n\n      <div class=\"space-y-6\" data-kid=\"81\">\n        <h4 class=\"font-serif text-2xl font-bold px-4\" data-kid=\"82\">Lembretes</h4>\n        <div class=\"space-y-4\" data-kid=\"83\">\n          <div class=\"bg-white p-6 rounded-[2rem] shadow-sm border border-[#4A3F35]/5 relative\" data-kid=\"84\">\n            <div class=\"absolute top-4 right-4 text-[#D4A373]\" data-kid=\"85\">\n              <i class=\"ti ti-pin\" data-kid=\"86\"></i>\n            </div>\n            <p class=\"text-xs font-bold text-[#D4A373] uppercase tracking-wider mb-2\" data-kid=\"87\">Pendente</p>\n            <p class=\"text-sm font-semibold mb-3\" data-kid=\"88\">Revisar orçamento da Casa Jurerê</p>\n            <p class=\"text-[10px] opacity-40\" data-kid=\"89\">Há 2 horas • Urgente</p>\n          </div>\n          \n          <div class=\"bg-[#CCD5AE]/10 p-6 rounded-[2rem] border border-[#CCD5AE]/20\" data-kid=\"90\">\n            <p class=\"text-xs font-bold text-[#4A3F35]/60 uppercase tracking-wider mb-2\" data-kid=\"91\">Sistema</p>\n            <p class=\"text-sm font-semibold mb-3\" data-kid=\"92\">Sincronização com WhatsApp concluída</p>\n            <p class=\"text-[10px] opacity-40\" data-kid=\"93\">Há 45 min • Automático</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>",
