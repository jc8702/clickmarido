# ============================================
# Click Marido — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env com credenciais reais.

# ------ Banco de Dados (Supabase / PostgreSQL) ------
# Connection pooler (Supavisor) — para runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta — para Prisma migrations e seed
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ------ Backend NestJS ------
PORT=3001
JWT_SECRET="gere-uma-chave-secreta-forte-aqui"
JWT_EXPIRES_IN="1h"

# ------ CORS (lista separada por vírgula) ------
CORS_ORIGIN="http://localhost:3000"

# ------ Frontend Next.js ------
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ------ Integrações ------
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="sua-chave-evolution-api"
GEMINI_API_KEY="sua-chave-gemini-api"
