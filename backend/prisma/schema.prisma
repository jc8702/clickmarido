// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  companyId   String?
  role        Role     @default(USER)
  isActive    Boolean  @default(true)
  resetToken  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company     Company? @relation(fields: [companyId], references: [id])
  serviceOrders ServiceOrder[]
  reports     Report[]
  warranties  Warranty[]
  sessions    Session[]
  appLogs     AppLog[]

  @@map("users")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String   @unique
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users User[]
  serviceOrders ServiceOrder[]
  reports Report[]
  warranties Warranty[]
  clients Client[]
  technicians Technician[]

  @@map("companies")
}

model ServiceOrder {
  id            String            @id @default(cuid())
  title         String
  description   String
  status        ServiceOrderStatus @default(OPEN)
  priority      Priority          @default(MEDIUM)
  value         Float?
  estimatedDate DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completedAt   DateTime?
  deletedAt     DateTime?
  clientId      String?
  technicianId  String?

  // Relations
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  client        Client?           @relation(fields: [clientId], references: [id])
  technician    Technician?       @relation(fields: [technicianId], references: [id])
  warranties    Warranty[]
  quotes        Quote[]
  payments      Payment[]

  @@map("service_orders")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quotes QuoteService[]

  @@map("services")
}

model Quote {
  id          String  @id @default(cuid())
  value       Float
  description String
  status      String  @default("PENDING")
  totalValue  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  payments       Payment[]
  quoteServices  QuoteService[]

  @@map("quotes")
}

model QuoteService {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  quantity    Int      @default(1)
  value       Float
  createdAt   DateTime @default(now())

  @@map("quote_services")
}

model Payment {
  id          String     @id @default(cuid())
  value       Float
  status      PaymentStatus @default(PENDING)
  method      PaymentMethod
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  quoteId        String?
  quote          Quote?       @relation(fields: [quoteId], references: [id])

  @@map("payments")
}

model Warranty {
  id          String            @id @default(cuid())
  title       String
  description String
  status      WarrantyStatus     @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  serviceOrderId String
  serviceOrder ServiceOrder     @relation(fields: [serviceOrderId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])

  @@map("warranties")
}

model Report {
  id          String   @id @default(cuid())
  type        ReportType
  title       String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("reports")
}

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  userId      String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  timestamp   DateTime  @default(now())
  companyId   String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

model Cache {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cache")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model AppLog {
  id          String   @id @default(cuid())
  level       String
  message     String
  metadata    Json?
  timestamp   DateTime @default(now())
  userId      String?
  companyId   String?
  createdAt   DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("app_logs")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  serviceOrders ServiceOrder[]

  @@map("clients")
}

model Technician {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  specialty String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  serviceOrders ServiceOrder[]

  @@map("technicians")
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PIX
  OTHER
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  CANCELLED
}

enum ReportType {
  SERVICE_ORDERS
  PAYMENTS
  WARRANTIES
  FINANCIAL
  PERFORMANCE
}